            "state" : "translated",
            "value" : "Увеличава звука до безопасната граница за всяка песен. Аудиофайловете не се променят."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυξάνει την ένταση εντός του ασφαλούς ορίου κάθε τραγουδιού. Τα αρχεία ήχου δεν αλλάζουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raises playback volume within each track’s safe limit. Your audio files stay unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta el volumen dentro del límite seguro de cada canción. Los archivos de audio no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume augmente dans la limite propre à chaque titre. Vos fichiers restent inchangés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangerőt az egyes számok biztonságos határáig növeli. A hangfájlok változatlanok maradnak."
          }
