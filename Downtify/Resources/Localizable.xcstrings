    "settings_stream_cache_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Място за наскоро слушано и предварително заредено аудио. Офлайн изтеглянията са отделни. Големите песни може да надвишат лимита; само целите песни се считат за готови."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χώρος για πρόσφατο και προφορτωμένο ήχο. Οι λήψεις εκτός σύνδεσης είναι ξεχωριστές. Τα μεγάλα τραγούδια μπορεί να υπερβούν το όριο· μόνο τα πλήρη τραγούδια θεωρούνται έτοιμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space for recently played and preloaded audio. Saved offline downloads are separate. Large songs may exceed this limit; only complete songs count as ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio para audio reciente y precargado. Las descargas sin conexión se guardan por separado. Las canciones grandes pueden superar este límite; solo cuentan como listas las canciones completas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace pour la musique récemment écoutée et préchargée. Les téléchargements hors ligne sont séparés. Les gros morceaux peuvent dépasser cette limite ; seuls les morceaux complets sont comptés comme prêts."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nemrég játszott és előtöltött hang tárhelye. Az offline letöltések külön maradnak. A nagy számok túlléphetik a korlátot; csak a teljes számok számítanak késznek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço para áudio recente e pré-carregado. Downloads offline são separados. Músicas grandes podem exceder esse limite; apenas músicas completas contam como prontas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son çalınan ve önceden yüklenen sesler için alan. Çevrimdışı indirmeler ayrıdır. Büyük şarkılar bu sınırı aşabilir; yalnızca tamamlanan şarkılar hazır sayılır."
          }
        }
      }
    },
