    "settings_normalize_volume_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пуска песните с близка сила по измерванията на сървъра, от следващата песен. Песните без измерване запазват оригиналната си сила."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παίζει τα τραγούδια σε παρόμοια ένταση με τις μετρήσεις του διακομιστή, από το επόμενο τραγούδι. Τα τραγούδια χωρίς μέτρηση κρατούν την αρχική τους ένταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays songs at a similar loudness, using the server’s measurements, from the next song. Songs without a measurement keep their original volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce las canciones con un volumen parecido según las mediciones del servidor, desde la siguiente canción. Las canciones sin medición mantienen su volumen original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les morceaux à un volume semblable d’après les mesures du serveur, dès le morceau suivant. Les morceaux sans mesure gardent leur volume d’origine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver mérései alapján hasonló hangerővel játssza le a dalokat, a következő daltól. A mérés nélküli dalok megtartják eredeti hangerejüket."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca as músicas com volume parecido usando as medições do servidor, a partir da próxima música. Músicas sem medição mantêm o volume original."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun ölçümlerini kullanarak şarkıları bir sonraki şarkıdan itibaren benzer ses seviyesinde çalar. Ölçümü olmayan şarkılar özgün ses seviyelerini korur."
          }
        }
      }
    },
