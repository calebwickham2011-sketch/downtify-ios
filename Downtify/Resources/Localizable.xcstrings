    "license_condition_notice_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запази известието за авторски права и копие от лиценза във всяко копие, което споделяш."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα την ειδοποίηση πνευματικών δικαιωμάτων και αντίγραφο της άδειας σε κάθε αντίγραφο που μοιράζεσαι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the copyright notice and a copy of the license with every copy you share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva el aviso de derechos de autor y una copia de la licencia en cada copia que compartas."
