        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements automatiques pourront le récupérer de nouveau. Rien n’est téléchargé maintenant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus letöltések újra letölthetik. Most semmi sem töltődik le."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
