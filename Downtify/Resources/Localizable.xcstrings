          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός οικιακού δικτύου και χωρίς HTTPS: το κλειδί του τηλεφώνου θα ταξίδευε χωρίς κρυπτογράφηση."
          }
        },
        "en" : {
          "stringUnit" : {
