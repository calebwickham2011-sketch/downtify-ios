    "Tap to check or uncheck options. Use the up and down arrows to reorder." : {

    },
    "terms_affiliation_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify не е свързан със, одобрен от или спонсориран от Spotify, YouTube, YouTube Music, Deezer, Soulseek или друга услуга, чрез която намира музика, откъси или обложки. Имената и логата им принадлежат на техните собственици."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Downtify δεν συνδέεται με, δεν εγκρίνεται από και δεν χορηγείται από τα Spotify, YouTube, YouTube Music, Deezer, Soulseek ή οποιαδήποτε άλλη υπηρεσία μέσω της οποίας βρίσκει μουσική, προεπισκοπήσεις ή εξώφυλλα. Τα ονόματα και τα λογότυπά τους ανήκουν στους ιδιοκτήτες τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify is not affiliated with, endorsed by or sponsored by Spotify, YouTube, YouTube Music, Deezer, Soulseek or any other service it can find music, previews or artwork through. Their names and logos belong to their owners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify no está afiliado, respaldado ni patrocinado por Spotify, YouTube, YouTube Music, Deezer, Soulseek ni ningún otro servicio por el que encuentre música, avances o carátulas. Sus nombres y logotipos pertenecen a sus respectivos dueños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify n’est ni affilié à, ni approuvé par, ni sponsorisé par Spotify, YouTube, YouTube Music, Deezer, Soulseek ou tout autre service par lequel il trouve de la musique, des aperçus ou des pochettes. Leurs noms et logos appartiennent à leurs propriétaires."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Downtify nincs kapcsolatban a Spotifyjal, a YouTube-bal, a YouTube Music-kal, a Deezerrel, a Soulseek-kel vagy bármely más szolgáltatással, amelyen keresztül zenét, előnézetet vagy borítót talál, és azok nem támogatják, nem hagyták jóvá. Nevük és logójuk a tulajdonosaiké."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Downtify não é afiliado, endossado nem patrocinado por Spotify, YouTube, YouTube Music, Deezer, Soulseek ou qualquer outro serviço por meio do qual encontre músicas, prévias ou capas. Os nomes e logotipos pertencem aos respectivos donos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify; Spotify, YouTube, YouTube Music, Deezer, Soulseek ya da müzik, önizleme veya kapak bulduğu başka bir hizmetle bağlantılı değildir; onlar tarafından onaylanmamış veya desteklenmemiştir. Adları ve logoları sahiplerine aittir."
          }
        }
      }
    },
    "terms_affiliation_title" : {
