    "terms_use_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify за Android е безплатен клиент с отворен код за Downtify — музикален сървър, който хостваш сам. Той възпроизвежда и управлява музиката на собствения ти сървър. Не е музикална услуга и не съхранява музика."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Downtify για Android είναι δωρεάν πελάτης ανοιχτού κώδικα για το Downtify, έναν διακομιστή μουσικής που φιλοξενείς ο ίδιος. Αναπαράγει και διαχειρίζεται τη μουσική του δικού σου διακομιστή. Δεν είναι υπηρεσία μουσικής και δεν φιλοξενεί καθόλου μουσική."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify for Android is a free, open-source client for Downtify, a music server you run yourself. It plays and manages the music on your own server. It is not a music service and it doesn't host any music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify para Android es un cliente gratuito y de código abierto de Downtify, un servidor de música que alojas tú mismo. Reproduce y gestiona la música de tu propio servidor. No es un servicio de música y no aloja ninguna música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify pour Android est un client gratuit et open source de Downtify, un serveur de musique que vous hébergez vous-même. Il lit et gère la musique de votre propre serveur. Ce n’est pas un service de musique et il n’héberge aucune musique."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Downtify Androidra a Downtify ingyenes, nyílt forráskódú klienseként egy saját üzemeltetésű zeneszerverhez készült. A saját szervered zenéit játssza le és kezeli. Nem zenei szolgáltatás, és nem tárol zenét."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Downtify para Android é um cliente gratuito e de código aberto do Downtify, um servidor de música que você mesmo hospeda. Ele toca e gerencia a música do seu próprio servidor. Não é um serviço de música e não hospeda nenhuma música."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android için Downtify, kendi barındırdığın bir müzik sunucusu olan Downtify'ın ücretsiz ve açık kaynaklı istemcisidir. Kendi sunucundaki müziği çalar ve yönetir. Bir müzik hizmeti değildir ve hiçbir müzik barındırmaz."
          }
        }
      }
    },
    "terms_use_title" : {
      "extractionState" : "manual",
      "localizations" : {
