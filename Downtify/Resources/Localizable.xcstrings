      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът не успя да се свърже с Deezer за някои от изпълнителите ти, затова списъкът е по-кратък от обичайното. Опитай по-късно."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν μπόρεσε να φτάσει στο Deezer για ορισμένους καλλιτέχνες σου, οπότε η λίστα είναι πιο σύντομη από το συνηθισμένο. Δοκίμασε αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server couldn't reach Deezer for some of your artists, so this list is shorter than usual. Try again later."
