    "terms_warranty_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението се предоставя „както е“, без гаранции от какъвто и да е вид, изрични или подразбиращи се, включително за пригодност за определена цел. Разработчиците не носят отговорност за претенции, щети, загуба на данни или правни последствия от използването на приложението."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή παρέχεται «ως έχει», χωρίς καμία εγγύηση, ρητή ή σιωπηρή, συμπεριλαμβανομένης της καταλληλότητας για συγκεκριμένο σκοπό. Οι προγραμματιστές δεν ευθύνονται για αξιώσεις, ζημιές, απώλεια δεδομένων ή νομικές συνέπειες που προκύπτουν από τη χρήση της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is provided \"as is\", without warranty of any kind, express or implied, including fitness for a particular purpose. The developers are not liable for any claim, damage, loss of data or legal consequence arising from using it, or from what you do with it. See the license for the full terms."
