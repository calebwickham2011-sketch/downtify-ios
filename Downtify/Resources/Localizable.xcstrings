        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no pudo consultar Deezer para algunos de tus artistas, así que esta lista es más corta de lo normal. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas pu joindre Deezer pour certains de vos artistes : cette liste est donc plus courte que d’habitude. Réessayez plus tard."
