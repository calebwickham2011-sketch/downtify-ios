    "downloads_empty_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисни Изтегляне върху албум или плейлист или дръж Харесани песни офлайн, за да слушаш без сървъра."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα Λήψη σε ένα άλμπουμ ή μια λίστα αναπαραγωγής, ή κράτα τα Αγαπημένα τραγούδια εκτός σύνδεσης, για να ακούς χωρίς τον διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Download on an album or a playlist, or keep your Liked songs offline, to listen without the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Descargar en un álbum o una lista, o mantén tus Canciones que me gustan sin conexión, para escuchar sin el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Télécharger sur un album ou une playlist, ou gardez vos Titres likés hors ligne, pour écouter sans le serveur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints a Letöltés gombra egy albumon vagy lejátszási listán, vagy tartsd offline a Kedvelt dalokat, hogy szerver nélkül hallgathass."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Baixar em um álbum ou playlist, ou mantenha suas Músicas curtidas offline, para ouvir sem o servidor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu olmadan dinlemek için bir albümde ya da çalma listesinde İndir'e dokun veya Beğenilen şarkılarını çevrimdışı tut."
          }
        }
      }
    },
    "downloads_empty_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
