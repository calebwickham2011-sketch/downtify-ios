        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors de votre réseau local et sans HTTPS : la clé du téléphone circulerait en clair."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem az otthoni hálózaton van, és nincs HTTPS: a telefon kulcsa titkosítatlanul utazna."
