        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez la mention de droit d’auteur et une copie de la licence avec chaque copie partagée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden megosztott példányhoz tartsd meg a szerzői jogi közleményt és a licenc egy másolatát."
