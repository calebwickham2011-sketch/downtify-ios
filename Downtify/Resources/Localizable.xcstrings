    },
    "donate_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify за Android е безплатен и с отворен код, правен в свободното време. Ако ти е полезен, можеш да помогнеш да продължи да се развива. Никога не е задължително и винаги е ценено."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Downtify για Android είναι δωρεάν και ανοιχτού κώδικα, φτιαγμένο στον ελεύθερο χρόνο. Αν σου είναι χρήσιμο, μπορείς να βοηθήσεις να συνεχίσει να υπάρχει. Ποτέ δεν είναι υποχρεωτικό και πάντα εκτιμάται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify for Android is free and open source, built in spare time. If it's useful to you, you can help keep it going. It's never required, and always appreciated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify para Android es gratuito y de código abierto, hecho en ratos libres. Si te resulta útil, puedes ayudar a mantenerlo vivo. Nunca es obligatorio y siempre se agradece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downtify pour Android est gratuit et open source, fait sur le temps libre. S’il vous est utile, vous pouvez aider à le faire vivre. Ce n’est jamais obligatoire, et toujours apprécié."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Downtify Androidra ingyenes és nyílt forráskódú, szabadidőben készül. Ha hasznos számodra, segíthetsz életben tartani. Soha nem kötelező, és mindig hálásak vagyunk érte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Downtify para Android é gratuito e de código aberto, feito nas horas vagas. Se ele é útil para você, pode ajudar a mantê-lo vivo. Nunca é obrigatório, e sempre é bem-vindo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android için Downtify ücretsiz ve açık kaynaklıdır, boş zamanlarda geliştirilir. İşine yarıyorsa yaşamasına yardım edebilirsin. Asla zorunlu değil, her zaman değerli."
          }
        }
      }
    },
